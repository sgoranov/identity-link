<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Identity Link{% endblock %}</title>

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>
<body>
<header class="bg-light py-3 mb-4 border-bottom">
    <div class="container d-flex justify-content-center">
        <h1 class="h3 m-0 text-primary">Identity Link</h1>
    </div>
</header>

<div class="container py-4">
    {% block content %}{% endblock %}
</div>

<footer class="container py-3 text-center">
    <div class="locale-links d-inline-flex gap-2">
        <a href="{{ path('switch_locale', { locale: 'en' }) }}">English</a>
        <a href="{{ path('switch_locale', { locale: 'bg' }) }}">Български</a>
    </div>
</footer>
</body>
</html>
