{% extends 'base.html.twig' %}

{% block content %}
    <h1>{{ 'login.title'|trans }}</h1>
    {% if error %}
        <div class="alert alert-danger" role="alert">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <div class="border rounded p-3 bg-light text-dark mb-4">
        <p class="mb-2">
            {{ 'form_login.requested_scopes'|trans({'%client%': client_name}) }}
        </p>
        <ul class="mb-0">
            {% for scope in scopes %}
                <li>{{ scope }}</li>
            {% endfor %}
        </ul>
    </div>

    {{ form(form) }}

    {% if resetPasswordUrl is not empty %}
        <div class="mt-3">
            <a href="{{ resetPasswordUrl }}">{{ 'login.forgot_password'|trans }}</a>
        </div>
    {% endif %}
{% endblock %}