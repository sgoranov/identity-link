{% extends 'base.html.twig' %}

{% block content %}
    <h1>{{ 'login.title'|trans }}</h1>
    {% for flash in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">
            {{ flash.key|trans(flash.params, 'security') }}
        </div>
    {% endfor %}

    {{ form(form) }}

    {% if resetPasswordUrl is not empty %}
        <div class="mt-3">
            <a href="{{ resetPasswordUrl }}">{{ 'login.forgot_password'|trans }}</a>
        </div>
    {% endif %}
{% endblock %}