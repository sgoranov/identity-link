{% extends 'base.html.twig' %}

{% block content %}
    <h1>{{ 'login.title'|trans }}</h1>
    {% if error %}
        <div class="alert alert-danger" role="alert">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}
    {{ form(form) }}
{% endblock %}