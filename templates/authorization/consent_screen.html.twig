{% extends 'base.html.twig' %}

{% block title %}{{ 'form_consent.title'|trans }}{% endblock %}

{% block content %}
    <div class="container my-5" style="max-width: 700px;">
        <div class="card shadow-sm rounded-3">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4">
                    {% if client.logoUrl %}
                        <img
                                src="{{ client.logoUrl }}"
                                alt="{{ client.name }}"
                                class="rounded me-3 border"
                                style="width: 64px; height: 64px; object-fit: contain; padding: 4px;"
                        >
                    {% endif %}

                    <div>
                        <h1 class="h4 mb-1">{{ 'form_consent.title'|trans }}</h1>
                        <p class="text-muted mb-0">
                            {% set clientName = client.applicationUrl
                                ? '<a href="' ~ client.applicationUrl ~ '" target="_blank" rel="noopener noreferrer">' ~ client.name|e ~ '</a>'
                                : client.name|e
                            %}

                            {{ 'form_consent.description'|trans({ '%client_name%': clientName })|raw  }}
                        </p>
                    </div>
                </div>

                <h5 class="mt-4 mb-3">{{ 'form_consent.permissions'|trans }}</h5>
                <ul class="list-group mb-4">
                    {% for scope in scopes %}
                        <li class="list-group-item d-flex align-items-start">
                            <div class="me-3 text-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <div class="fw-bold">{{ ('scopes.' ~ scope ~ '.label')|trans }}</div>
                                <small class="text-muted">{{ ('scopes.' ~ scope ~ '.description')|trans }}</small>
                            </div>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted fst-italic">
                            {{ 'form_consent.no_permissions'|trans }}
                        </li>
                    {% endfor %}
                </ul>

                {% if client.privacyPolicyUrl or client.termsOfServiceUrl %}
                    <p class="text-muted">
                        {{ 'form_consent.data_info'|trans }}
                    </p>

                    {% if client.privacyPolicyUrl %}
                        <a href="{{ client.privacyPolicyUrl }}"
                           target="_blank"
                           rel="noopener noreferrer">
                            {{ 'form_consent.privacy_policy'|trans }}
                        </a>
                    {% endif %}

                    {% if client.privacyPolicyUrl and client.termsOfServiceUrl %}
                        &middot;
                    {% endif %}

                    {% if client.termsOfServiceUrl %}
                        <a href="{{ client.termsOfServiceUrl }}"
                           target="_blank"
                           rel="noopener noreferrer">
                            {{ 'form_consent.terms_of_service'|trans }}
                        </a>
                    {% endif %}
                {% endif %}

                {{ form_start(form) }}
                <div class="d-flex gap-3 justify-content-end">
                    {{ form_widget(form.deny, { 'attr': { 'class': 'btn btn-outline-secondary' } }) }}
                    {{ form_widget(form.allow, { 'attr': { 'class': 'btn btn-primary' } }) }}
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
