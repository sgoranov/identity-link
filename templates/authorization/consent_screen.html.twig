{% extends 'base.html.twig' %}

{% block title %}{{ 'form_consent.title'|trans }}{% endblock %}

{% block content %}
    <div class="container mt-5">
        <h1>{{ 'form_consent.title'|trans }}</h1>

        <p>{{ 'form_consent.description'|trans({ '%client_name%': client.name }) }}</p>

        {{ form_start(form) }}
        <div class="mb-3">
            <p>{{ 'form_consent.request'|trans({ '%scopes%': scopes|join(', ') }) }}</p>
        </div>

        <div class="d-flex gap-3">
            {{ form_widget(form.allow, { 'attr': { 'class': 'btn btn-success' } }) }}
            {{ form_widget(form.deny, { 'attr': { 'class': 'btn btn-danger' } }) }}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
