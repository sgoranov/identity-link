        <mxCell id="obYorNC8pEpNs_z5_JDt-73" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="540" width="1170" x="-730" y="310" as="geometry" />
        </mxCell>
        <mxCell id="obYorNC8pEpNs_z5_JDt-60" parent="obYorNC8pEpNs_z5_JDt-73" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFFCC;fontColor=#ffffff;strokeColor=#2D7600;" value="" vertex="1">
          <mxGeometry height="560" width="1170" y="-50" as="geometry" />
        </mxCell>
        <mxCell id="obYorNC8pEpNs_z5_JDt-5" parent="obYorNC8pEpNs_z5_JDt-73" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#97D077;" value="&lt;h1&gt;Nginx&lt;/h1&gt;Serving as the &lt;b data-path-to-node=&quot;2,0&quot; data-index-in-node=&quot;21&quot;&gt;primary entry point&lt;/b&gt; for the Application Layer, Nginx acts as a high-performance reverse proxy and static file server. It efficiently manages all incoming client traffic, enforcing initial request handling before distributing load to the underlying backend services." vertex="1">
          <mxGeometry height="175.77" width="260" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="obYorNC8pEpNs_z5_JDt-59" parent="obYorNC8pEpNs_z5_JDt-73" style="rounded=1;align=center;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#67AB9F;" value="&lt;h1&gt;Core&lt;/h1&gt;Oauth2 and OpenID connect support" vertex="1">
          <mxGeometry height="166.15384615384616" width="190" x="75" y="305.34538461538466" as="geometry" />
        </mxCell>
        <mxCell id="obYorNC8pEpNs_z5_JDt-62" connectable="0" parent="obYorNC8pEpNs_z5_JDt-73" style="group" value="" vertex="1">
          <mxGeometry height="362.88" width="685" x="460" y="120" as="geometry" />
        </mxCell>
        <mxCell id="obYorNC8pEpNs_z5_JDt-64" parent="obYorNC8pEpNs_z5_JDt-73" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Security&lt;/h1&gt;&lt;p&gt;REST API communication is secured via JWT (JSON Web Tokens). Each service independently verifies the token signature by retrieving public keys from the JWKS (JSON Web Key Set) endpoint provided by the Core.&lt;/p&gt;" vertex="1">
          <mxGeometry height="207.6923076923077" width="180" x="270" y="185.77384615384622" as="geometry" />
        </mxCell>
        <mxCell id="obYorNC8pEpNs_z5_JDt-67" edge="1" parent="obYorNC8pEpNs_z5_JDt-73" source="obYorNC8pEpNs_z5_JDt-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="obYorNC8pEpNs_z5_JDt-59">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="obYorNC8pEpNs_z5_JDt-63" edge="1" parent="obYorNC8pEpNs_z5_JDt-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.002;entryY=0.578;entryDx=0;entryDy=0;endArrow=classic;endFill=1;entryPerimeter=0;">
