#!/bin/bash

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
cd "$PROJECT_ROOT"

# Keep this stack isolated from other Compose applications using this checkout.
COMPOSE_ARGS=(-p identity-link-test -f docker-compose-test.yaml)

echo "Cleaning up previous debug session..."
docker compose "${COMPOSE_ARGS[@]}" down -v

echo "Starting tests..."
docker compose "${COMPOSE_ARGS[@]}" up \
  --build \
  --force-recreate \
  --renew-anon-volumes \
  --exit-code-from identity-link-core-test \
  --abort-on-container-exit

TEST_EXIT_CODE=$?

echo "Cleaning up test environment..."
docker compose "${COMPOSE_ARGS[@]}" down -v

exit $TEST_EXIT_CODE
