#!/bin/bash

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
cd "$PROJECT_ROOT"

set -a
[ -f .env ] && source .env
[ -f .env.test ] && source .env.test
[ -f .env.test.local ] && source .env.test.local
set +a

echo "Cleaning up previous debug session..."
docker compose -f docker-compose-test.yaml down --remove-orphans

echo "Starting debug environment..."
docker compose -f docker-compose-test.yaml run --build --rm identity-link-core-test-debug