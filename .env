# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=prod
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
APP_SECRET_FILE=/run/secrets/app_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=15&charset=utf8"
DATABASE_URL="postgresql://%env(default:fallback_db_user:file:DB_USER_FILE)%:%env(default:fallback_db_password:file:DB_PASSWORD_FILE)%@%env(DB_HOST)%:%env(DB_PORT)%/%env(DB_NAME)%?serverVersion=15&charset=utf8"
DB_NAME=identity-link
DB_USER=ChangeMe
DB_USER_FILE=/run/secrets/db_user
DB_PASSWORD=ChangeMe
DB_PASSWORD_FILE=/run/secrets/db_password
DB_HOST=identity-link-database-server
DB_PORT=5432

###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

# Canonical URL identifying this service as both the JWT issuer and protected-resource audience.
# Client registrations targeting this API must use the same value as their audience.
JWT_URL=https://example.com/identity-link

ENCRYPTION_KEY_PATH=/run/secrets/encryption_key

# Whether to include the "groups" claim in the generated JWT tokens
JWT_INCLUDE_GROUPS_CLAIM=true

# Maximum number of groups to include in the JWT "groups" claim (if enabled)
JWT_GROUPS_CLAIM_LIMIT=50

# Redis server connection string
REDIS_DSN=redis://identity-link-redis:6379?prefix=core

###> DbUserConnector ###
# User service API endpoints for external user management microservice.
# Used by DbUserConnector (implements UserConnectorInterface) to authenticate,
# query, and fetch user data.
# See: https://github.com/sgoranov/identity-link-db-users

USER_QUERY_ENDPOINT=http://identity-link-db-users:9001/api/v1/query
USER_AUTH_ENDPOINT=http://identity-link-db-users:9001/api/v1/auth
USER_FETCH_ENDPOINT=http://identity-link-db-users:9001/api/v1/user/{id}
USER_SCOPE_ENDPOINT=http://identity-link-db-users:9001/api/v1/user/{id}/scope

# If empty, the reset password option will not be shown to users.
RESET_PASSWORD_URL=https://example.com/users/reset-password/{id}
###< DbUserConnector ###

###> DbClientConnector ###
# Client service API endpoints for external client management microservice.
# Used by DbClientConnector (implements ClientConnectorInterface) to authenticate
# and query client data.
# See: https://github.com/sgoranov/identity-link-db-clients
CLIENT_AUTH_ENDPOINT=http://identity-link-db-clients:9002/api/v1/auth
CLIENT_QUERY_ENDPOINT=http://identity-link-db-clients:9002/api/v1/query
CLIENT_SCOPE_ENDPOINT=http://identity-link-db-clients:9002/api/v1/client/{id}/scope
###< DbClientConnector ###

###> TwoFaConnector ###
# Two-factor authentication (2FA) service API endpoints.
# Used by TwoFaConnector (implements TwoFaConnectorInterface) to perform
# authentication and verification.
# To disable 2FA, leave TWO_FA_AUTH_ENDPOINT empty.
# See: https://github.com/sgoranov/identity-link-2fa

# Endpoint for 2FA authentication
TWO_FA_AUTH_ENDPOINT=http://identity-link-2fa:9003/api/v1/auth

# Endpoint to verify 2FA token by user ID (replace {id} with user ID)
TWO_FA_INDEX_ENDPOINT=https://example.com/2fa/2fa/verify/{id}
###< TwoFaConnector ###

# Whether to include the Two-Factor Authentication step in the login flow.
# true  = After username/password, user must pass a second factor (e.g., code, app, SMS) before continuing.
# false = Skip 2FA step entirely.
LOGIN_TWO_FA_ENABLED=true

# Access Token TTL - PT15M = 15 Minutes
# Short lifetimes reduce the window of vulnerability if a token is leaked.
# Clients should use Refresh Tokens silently in the background to get new ones.
OAUTH2_ACCESS_TOKEN_TTL=PT15M

# Refresh Token TTL - P14D = 14 Days
# 14 days is a solid balance between user convenience (not having to log in constantly)
# and security.
OAUTH2_REFRESH_TOKEN_TTL=P14D

# Authorization Code TTL - PT5M = 5 Minutes
# Auth codes are only meant to be exchanged *immediately* for tokens.
OAUTH2_AUTH_CODE_TTL=PT5M

# Active OAuth2 grant types (comma-separated)
# Allowed values: client_credentials, password, refresh_token, authorization_code, implicit
OAUTH2_ENABLED_GRANTS=client_credentials,refresh_token,authorization_code
