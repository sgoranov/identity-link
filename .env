# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
TRUSTED_PROXIES=
APP_SECRET=f359e859bad842746cd9249e0c4a5a03
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=15&charset=utf8"
DATABASE_URL="postgresql://%env(DB_USER)%:%env(DB_PASSWORD)%@%env(DB_HOST)%:%env(DB_PORT)%/identity-link?serverVersion=15&charset=utf8"

DB_USER=ChangeMe
DB_PASSWORD=ChangeMe
DB_HOST=host.docker.internal
DB_PORT=9006

###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

# Type of authenticator to use (currently only "PasswordAuthenticator" is supported)
AUTHENTICATOR_TYPE=PasswordAuthenticator

# Whether to include the "groups" claim in the generated JWT tokens
JWT_INCLUDE_GROUPS_CLAIM=true

# Maximum number of groups to include in the JWT "groups" claim (if enabled)
JWT_GROUPS_CLAIM_LIMIT=50

# Redis server connection string (used only when APP_ENV=distributed)
REDIS_DSN=redis://host.docker.internal:9008

# OIDC_EXTRA_CLAIMS is a JSON-encoded map of custom (non-standard) claims
# that should be included in the ID Token or UserInfo response.
# This allows the application to expose additional identity attributes beyond the standard OpenID Connect claims.
#
# Keys can be logical categories (e.g., "groups", "account", "permissions"), and the values are arrays of field names.
# These claims are typically derived from your application's domain model (e.g., user roles, org units, feature flags).
#
# Example:
# {
#   "groups": ["groups"],
#   "account": ["employee_id", "department", "account_status"],
#   "permissions": ["feature_flags", "access_level"]
# }
# OIDC_EXTRA_CLAIMS='{"groups":["groups"],"account":["employee_id","department","account_status"],"permissions":["feature_flags","access_level"]}'
OIDC_EXTRA_CLAIMS=

###> DbUserConnector ###
# User service API endpoints for external user management microservice.
# Used by DbUserConnector (implements UserConnectorInterface) to authenticate,
# query, and fetch user data.
# See: https://github.com/sgoranov/identity-link-db-users

# Endpoint to query users (search/filter)
USER_QUERY_ENDPOINT=http://host.docker.internal:9001/api/v1/query

# Endpoint for user authentication
USER_AUTH_ENDPOINT=http://host.docker.internal:9001/api/v1/auth

# Endpoint to fetch user details by ID (replace {id} with user ID)
USER_FETCH_ENDPOINT=http://host.docker.internal:9001/api/v1/user/{id}

# If empty, the reset password option will not be shown to users.
RESET_PASSWORD_URL=https://auth.example.com/users/reset-password/{id}
###< DbUserConnector ###

###> DbClientConnector ###
# Client service API endpoints for external client management microservice.
# Used by DbClientConnector (implements ClientConnectorInterface) to authenticate
# and query client data.
# See: https://github.com/sgoranov/identity-link-db-clients

# Endpoint for client authentication
CLIENT_AUTH_ENDPOINT=http://host.docker.internal:9002/api/v1/auth

# Endpoint to query clients (search/filter)
CLIENT_QUERY_ENDPOINT=http://host.docker.internal:9002/api/v1/query
###< DbClientConnector ###

###> TwoFaConnector ###
# Two-factor authentication (2FA) service API endpoints.
# Used by TwoFaConnector (implements TwoFaConnectorInterface) to perform
# authentication and verification.
# To disable 2FA, leave TWO_FA_AUTH_ENDPOINT empty.
# See: https://github.com/sgoranov/identity-link-2fa

# Endpoint for 2FA authentication
TWO_FA_AUTH_ENDPOINT=http://host.docker.internal:9003/api/v1/auth

# Endpoint to verify 2FA token by user ID (replace {id} with user ID)
TWO_FA_INDEX_ENDPOINT=https://auth.example.com/2fa/2fa/verify/{id}
###< TwoFaConnector ###

# Whether to include the Two-Factor Authentication step in the login flow.
# true  = After username/password, user must pass a second factor (e.g., code, app, SMS) before continuing.
# false = Skip 2FA step entirely.
LOGIN_TWO_FA_ENABLED=true

# Whether to include a consent screen step in the authorization flow.
# true  = After login (and 2FA if enabled), user will be asked to approve requested scopes/permissions.
# false = Skip consent screen entirely
CONSENT_SCREEN_ENABLED=true