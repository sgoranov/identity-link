{
    "name": "sgoranov/identity-link",
    "type": "project",
    "license": "MIT",
    "keywords": ["oauth2", "server"],
    "homepage": "https://github.com/sgoranov/identity-link",
    "authors": [
        {
            "name": "Simeon Goranov",
            "email": "sgoranov@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-openssl": "*",
        "ext-pgsql": "*",
        "defuse/php-encryption": "^2.4",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^3",
        "firebase/php-jwt": "^7",
        "league/oauth2-server": "^9",
        "nyholm/psr7": "^1.8",
        "sgoranov/identity-link-shared": "dev-develop",
        "steverhoades/oauth2-openid-connect-server": "^3.0",
        "strobotti/php-jwk": "^1.4",
        "symfony/asset": "6.4.*",
        "symfony/asset-mapper": "6.4.*",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/event-dispatcher": "6.4.*",
        "symfony/expression-language": "6.4.*",
        "symfony/flex": "^2",
        "symfony/form": "6.4.*",
        "symfony/framework-bundle": "6.4.*",
        "symfony/http-client": "6.4.*",
        "symfony/lock": "6.4.*",
        "symfony/monolog-bundle": "^3.8",
        "symfony/psr-http-message-bridge": "^2.3",
        "symfony/rate-limiter": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/security-csrf": "6.4.*",
        "symfony/serializer": "6.4.*",
        "symfony/translation": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/uid": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/yaml": "6.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.5.0",
            "ext-pgsql": "8.5.0",
            "ext-sodium": "8.5.0",
            "ext-sqlite3": "8.5.0"
        },
        "sort-packages": true,
        "audit": {
            "ignore-abandoned": [
                "sebastian/code-unit",
                "sebastian/code-unit-reverse-lookup"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8",
        "doctrine/doctrine-fixtures-bundle": "^4",
        "phpunit/phpunit": "^10",
        "symfony/browser-kit": "6.4.*",
        "symfony/debug-bundle": "6.4.*",
        "symfony/maker-bundle": "^1.51",
        "symfony/phpunit-bridge": "6.4.*",
        "symfony/web-profiler-bundle": "6.4.*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sgoranov/identity-link-shared"
        }
    ]
}
